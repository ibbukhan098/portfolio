---
// A case-study page laid out as a feature story: headline block, body, and a
// sidebar ("fact box") for metadata and the sources the story cites.
import Paper from './Paper.astro';
import { getSource } from '../data/sources';

interface Fact {
  label: string;
  value: string;
}

interface Props {
  title: string;
  kicker: string;
  headline: string;
  deck: string;
  status?: string;
  facts: Fact[];
  cites: string[];
  next?: { href: string; headline: string };
}

const { title, kicker, headline, deck, status, facts, cites, next } = Astro.props;
const cited = cites.map(getSource);
---

<Paper title={title} description={deck}>
  <article class="story">
    <header class="story-header">
      <div class="meta">
        <span class="label kicker">{kicker}</span>
        {status && <span class="label status">{status}</span>}
      </div>
      <h1>{headline}</h1>
      <p class="deck">{deck}</p>
    </header>

    <div class="layout">
      <div class="body">
        <slot />
      </div>

      <aside class="factbox">
        <section>
          <h2 class="label">Fact box</h2>
          <dl>
            {facts.map((f) => (
              <div>
                <dt class="label">{f.label}</dt>
                <dd set:html={f.value} />
              </div>
            ))}
          </dl>
        </section>
        <section>
          <h2 class="label">Sources in this story</h2>
          <ol>
            {cited.map((s) => (
              <li>
                <a href={`/sources#${s.id}`}>
                  <span class="n">{s.n}</span>
                  <span>{s.title}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      </aside>
    </div>

    {next && (
      <a class="next double-rule" href={next.href}>
        <span class="label">Next story ›</span>
        <span class="next-head">{next.headline}</span>
      </a>
    )}
  </article>
</Paper>

<style>
  .story-header {
    padding: 32px 0 20px;
    border-bottom: 1px solid var(--ink);
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 920px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    align-items: center;
  }

  .status {
    padding: 4px 8px;
    border: 1px solid var(--ink);
  }

  h1 {
    margin: 0;
    font: 900 clamp(36px, 5vw, 60px) / 1.03 var(--font-head);
    letter-spacing: -0.015em;
  }

  .deck {
    margin: 0;
    font: italic 400 clamp(19px, 2vw, 23px) / 1.4 var(--font-head);
    color: var(--ink-2);
  }

  .layout {
    display: flex;
    flex-wrap: wrap;
    gap: 32px 48px;
    padding-top: 28px;
  }

  .body {
    flex: 999 1 560px;
    min-width: 0;
    max-width: 720px;
    font-size: 19px;
    line-height: 1.65;
  }

  .body :global(h2) {
    margin: 36px 0 10px;
    font: 700 28px/1.2 var(--font-head);
  }

  .body :global(h2:first-child) {
    margin-top: 0;
  }

  .body :global(p) {
    margin: 0 0 16px;
  }

  .body :global(ul),
  .body :global(ol) {
    margin: 0 0 16px;
    padding-left: 22px;
  }

  .body :global(blockquote) {
    margin: 24px 0;
    padding: 12px 0;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    font: italic 400 26px/1.3 var(--font-head);
  }

  .factbox {
    flex: 1 1 280px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-self: flex-start;
  }

  .factbox section {
    border-top: 4px solid var(--ink);
    padding-top: 8px;
  }

  .factbox h2 {
    margin: 0 0 8px;
  }

  dl {
    margin: 0;
  }

  dl div {
    padding: 8px 0;
    border-bottom: 1px solid var(--rule);
  }

  dt {
    color: var(--ink-3);
    letter-spacing: 0.08em;
  }

  dd {
    margin: 2px 0 0;
    font-size: 16px;
    line-height: 1.45;
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  ol a {
    display: flex;
    gap: 10px;
    padding: 8px 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    font-size: 15px;
    line-height: 1.4;
  }

  .n {
    font: 700 12px/1.6 var(--font-label);
    color: var(--accent);
    min-width: 18px;
  }

  .next {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 40px;
    padding-top: 14px;
    text-decoration: none;
  }

  .next-head {
    font: 700 30px/1.15 var(--font-head);
  }
</style>
