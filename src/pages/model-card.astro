---
import Paper from '../layouts/Paper.astro';
import Cite from '../components/Cite.astro';
import Todo from '../components/Todo.astro';
import { site } from '../data/site';
---

<Paper title="Model card" description="Ibrahim Ali Khan, described the way a machine-learning model would be.">
  <header class="intro">
    <span class="label kicker">Specifications</span>
    <h1>Model card: ibrahim-ali-khan</h1>
    <p>Version 2026.10 · Licence: open to work</p>
  </header>

  <dl class="card">
    <div>
      <dt class="label">Intended use</dt>
      <dd>LLM features, RAG and AI agents, document AI, and the full-stack product work around them.<Cite id="skills" /></dd>
    </div>
    <div>
      <dt class="label">Training data</dt>
      <dd>
        B.Eng. Electronics &amp; Communication, Siddaganga Institute of Technology (2018). M.Sc. Computer
        Engineering, Paderborn University (expected October 2026).<Cite id="education" /> 3+ years in
        industry.<Cite id="fullstack" />
      </dd>
    </div>
    <div>
      <dt class="label">Evaluations</dt>
      <dd>
        ≈ −50% release time<Cite id="optimaite-deploy" /> · +40% engagement<Cite id="writegenius" /> ·
        −25% load time<Cite id="bond" /> · +25% performance<Cite id="catalogsync" /> · two Spot Awards<Cite id="awards" />
      </dd>
    </div>
    <div>
      <dt class="label">Deployment</dt>
      <dd>{site.availability}.</dd>
    </div>
    <div>
      <dt class="label">Languages</dt>
      <dd>English (C1), German (B1), Urdu (C1), Hindi (C1)</dd>
    </div>
    <div>
      <dt class="label">Known limitations</dt>
      <dd><Todo>one honest, slightly funny limitation</Todo></dd>
    </div>
    <div>
      <dt class="label">Contact</dt>
      <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
    </div>
  </dl>
</Paper>

<style>
  .intro {
    padding: 32px 0 20px;
    border-bottom: 4px double var(--ink);
    max-width: 820px;
  }

  h1 {
    margin: 10px 0 6px;
    font: 900 clamp(34px, 4.5vw, 52px) / 1.05 var(--font-head);
  }

  .intro p {
    margin: 0;
    font: 700 13px var(--font-label);
    letter-spacing: 0.06em;
  }

  .card {
    margin: 0;
    max-width: 820px;
  }

  .card div {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
    padding: 16px 0;
    border-bottom: 1px solid var(--rule);
  }

  dt {
    flex: 0 0 180px;
    padding-top: 4px;
  }

  dd {
    flex: 1 1 320px;
    margin: 0;
    font-size: 19px;
  }
</style>
