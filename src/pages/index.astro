---
import Paper from '../layouts/Paper.astro';
import Cite from '../components/Cite.astro';
import AskTheRecord from '../components/AskTheRecord.astro';
import { site } from '../data/site';
import { url } from '../lib/url';

const stories = [
  {
    href: '/work/thesis',
    kicker: 'Health · In progress',
    headline: 'Talking to health records, without saying more than they do',
    blurb: 'A FHIR-based hospital system with AI agents that must stay grounded, benchmarked on local vs. cloud models.',
    page: 'Page 2',
  },
  {
    href: '/work/clausecraft',
    kicker: 'Legal tech · Live',
    headline: 'The job-assignment MVP that became a full product',
    blurb: 'ClauseCraft drafts contracts, rates each clause for risk and flags what’s missing.',
    page: 'Page 3',
  },
  {
    href: '/work/amoebots',
    kicker: 'Science · Interactive',
    headline: 'Finding symmetry when every particle is blind',
    blurb: 'A distributed algorithm for programmable matter that runs in O(log⁵ n) time.',
    page: 'Page 4',
  },
];

const index = [
  { name: 'Optimaite release time', change: '≈ −50%', note: 'Docker + Coolify deployments', cite: 'optimaite-deploy' },
  { name: 'WriteGenius engagement', change: '+40%', note: 'over 6 months, team of 4', cite: 'writegenius' },
  { name: 'BOND load time', change: '−25%', note: 'AngularJS → React migration', cite: 'bond' },
  { name: 'Catalog Sync performance', change: '+25%', note: 'GraphQL + Shopify/WooCommerce', cite: 'catalogsync' },
  { name: 'LineSheets engagement', change: '+35%', note: 'UI revamp in Vue', cite: 'linesheets' },
  { name: 'Spot Awards', change: '2', note: 'top performer, Q4 2022 and Q2 2023', cite: 'awards' },
];
---

<Paper front>
  <div class="front">
    <article class="lead">
      <span class="label kicker">AI engineering</span>
      <h1>Local engineer builds AI that only says what the record supports</h1>
      <p class="deck">
        Optimaite’s founding engineer and Fraunhofer IEM researcher argues the hard part isn’t the answer.
        It’s the proof.
      </p>
      <div class="byline label">
        <span>By {site.name}</span>
        <span>Every claim sourced</span>
      </div>

      <div class="lead-body">
        <div class="columns">
          <p>
            <span class="dropcap">I</span>brahim Ali Khan is a Founding Engineer at Optimaite, a Fraunhofer
            IEM spin-off building a data-sovereign AI platform for law firms.<Cite id="optimaite" /> He builds
            its RAG pipelines and tool-using agents, with tracing, audit logs and tenant isolation for sensitive
            documents.<Cite id="optimaite-rag" /> He also works as a research assistant in Fraunhofer IEM’s
            GenAI Incubator.<Cite id="fraunhofer" />
          </p>
          <p>
            His master’s thesis is a privacy-preserving, FHIR-based hospital system<Cite id="thesis" /> where
            patients and doctors can question health records in plain language, and the assistant never says
            anything the record cannot support.<Cite id="thesis-post" />
          </p>
          <p>
            Before AI, he spent 3+ years shipping full-stack products<Cite id="fullstack" />, including a
            React migration that cut load times by 25%<Cite id="bond" /> and a contract assistant that
            started as a job assignment and turned into a full product.<Cite id="clausecraft" />
          </p>
          <p><a href="#work" class="continued">Continued in Work ›</a></p>
        </div>

        <figure class="portrait">
          <div class="photo"><span class="todo">Add public/portrait.jpg</span></div>
          <figcaption>The engineer in Paderborn, where he is finishing his master’s degree.</figcaption>
        </figure>
      </div>
    </article>

    <aside class="sidebar">
      <AskTheRecord />

      <section class="classifieds" aria-labelledby="classifieds-heading">
        <h2 id="classifieds-heading" class="label">Classifieds</h2>
        <p class="ad-head">WANTED: AI engineering role.</p>
        <p>
          {site.availability}. English and German. LLM features, agents, document AI, full-stack.
          Inquire: <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </section>
    </aside>
  </div>

  <section id="work" class="edition double-rule" aria-labelledby="edition-heading">
    <h2 id="edition-heading" class="label">Also in this edition</h2>
    <div class="stories">
      {stories.map((s) => (
        <a href={url(s.href)} class="story">
          <span class="label kicker">{s.kicker}</span>
          <span class="story-head">{s.headline}</span>
          <span class="story-blurb">{s.blurb} <span class="label">{s.page} ›</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="markets rule-top" aria-labelledby="markets-heading">
    <div class="markets-head">
      <h2 id="markets-heading" class="label">Markets · The Engineering Index</h2>
      <span class="label muted">2021 – today</span>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th scope="col">Instrument</th><th scope="col">Change</th><th scope="col">Note</th></tr>
        </thead>
        <tbody>
          {index.map((row) => (
            <tr>
              <th scope="row">{row.name}</th>
              <td class="change">{row.change}<Cite id={row.cite} /></td>
              <td>{row.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Paper>

<style>
  .front {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    padding-top: 28px;
  }

  .lead {
    flex: 2 1 640px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  h1 {
    margin: 0;
    font: 900 clamp(38px, 5.2vw, 64px) / 1.02 var(--font-head);
    letter-spacing: -0.015em;
  }

  .deck {
    margin: 0;
    font: italic 400 clamp(19px, 2vw, 23px) / 1.4 var(--font-head);
    color: var(--ink-2);
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px;
    padding: 8px 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    color: var(--ink-3);
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .lead-body {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }

  .columns {
    flex: 1 1 360px;
    min-width: 0;
    columns: 220px 2;
    column-gap: 24px;
    column-rule: 1px solid var(--rule);
    text-align: justify;
    hyphens: auto;
  }

  .columns p {
    margin: 0 0 12px;
  }

  .dropcap {
    float: left;
    font: 900 66px/0.8 var(--font-head);
    padding: 6px 8px 0 0;
  }

  .continued {
    font-weight: 600;
  }

  .portrait {
    flex: 1 1 240px;
    min-width: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .photo {
    aspect-ratio: 4 / 5;
    background: #e4e4e4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  figcaption {
    font-style: italic;
    font-size: 14px;
    line-height: 1.4;
    color: var(--ink-3);
  }

  .sidebar {
    flex: 1 1 340px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
    border-left: 1px solid var(--ink);
    padding-left: 28px;
  }

  .classifieds {
    border: 2px solid var(--ink);
    padding: 16px;
  }

  .classifieds h2 {
    margin: 0 0 8px;
  }

  .classifieds p {
    margin: 0;
    font-size: 15px;
  }

  .classifieds .ad-head {
    font: 700 22px/1.15 var(--font-head);
    margin-bottom: 6px;
  }

  .edition {
    margin-top: 36px;
    padding-top: 14px;
  }

  .edition h2,
  .markets h2 {
    margin: 0;
  }

  .stories {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    margin-top: 14px;
  }

  .story {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 4px 20px 12px;
    text-decoration: none;
    border-left: 1px solid var(--rule);
  }

  .story:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .story-head {
    font: 700 26px/1.12 var(--font-head);
  }

  .story:hover .story-head {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .story-blurb {
    font-size: 15px;
    color: var(--ink-2);
  }

  .markets {
    margin-top: 32px;
    padding-top: 12px;
  }

  .markets-head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .muted {
    color: var(--ink-3);
  }

  .table-wrap {
    overflow-x: auto;
    margin-top: 10px;
  }

  table {
    width: 100%;
    min-width: 520px;
    border-collapse: collapse;
    font-size: 16px;
  }

  th,
  td {
    text-align: left;
    padding: 8px 12px 8px 0;
    border-bottom: 1px solid var(--rule);
  }

  thead th {
    font: 800 11px/1.3 var(--font-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--ink);
  }

  tbody th {
    font-weight: 600;
  }

  .change {
    font: 700 18px var(--font-label);
    white-space: nowrap;
  }

  /* Below this width the sidebar wraps under the lead story. */
  @media (max-width: 1080px) {
    .sidebar {
      border-left: 0;
      padding-left: 0;
      border-top: 1px solid var(--ink);
      padding-top: 16px;
    }
  }

  @media (max-width: 720px) {
    .story,
    .story:first-child {
      padding: 12px 0;
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
  }
</style>
