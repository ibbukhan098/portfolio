---
import Paper from '../layouts/Paper.astro';
import { site } from '../data/site';
import { url } from '../lib/url';
---

<Paper title="Legal notice" description="Legal notice (Impressum) for this website.">
  <article class="legal">
    <span class="label kicker">Legal notice</span>
    <h1>Legal notice</h1>
    <p class="note">
      English translation of the <a href={url('/de/impressum')}>German Impressum</a>. If the two differ, the
      German version applies.
    </p>

    <h2>Information pursuant to § 5 DDG (German Digital Services Act)</h2>
    <address>
      {site.name}<br />
      {site.address.street}<br />
      {site.address.postcode} {site.address.city}<br />
      {site.address.country.en}
    </address>

    <h2>Contact</h2>
    <p>
      Email: <a href={`mailto:${site.email}`}>{site.email}</a><br />
      Phone: <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a>
    </p>

    <h2>Responsible for content under § 18(2) MStV (German Interstate Media Treaty)</h2>
    <p>{site.name}, address as above.</p>

    <h2>Liability for content</h2>
    <p>
      The content of this site was written with care, but I cannot guarantee that it is accurate, complete or
      up to date. As a service provider I am responsible for my own content on these pages under general law.
    </p>

    <h2>Liability for links</h2>
    <p>
      This site links to external third-party websites (such as LinkedIn and GitHub) whose content I do not
      control. The respective provider is always responsible for that content. If I become aware of any legal
      violation, I will remove the link immediately.
    </p>

    <h2>Copyright</h2>
    <p>
      The content and works I created on this site are subject to German copyright law. The site’s source code
      is available on <a href={site.links.github}>GitHub</a>.
    </p>

    <p class="see-also"><a href={url('/datenschutz')}>Privacy policy ›</a></p>
  </article>
</Paper>

<style>
  .legal {
    max-width: 720px;
    padding: 32px 0;
  }

  h1 {
    font: 900 44px/1.1 var(--font-head);
    margin: 10px 0 12px;
  }

  h2 {
    font: 700 22px/1.25 var(--font-head);
    margin: 28px 0 8px;
  }

  p,
  address {
    margin: 0 0 12px;
    font-style: normal;
  }

  .note {
    font-style: italic;
    color: var(--ink-3);
  }

  .see-also {
    margin-top: 32px;
    font-weight: 600;
  }
</style>
