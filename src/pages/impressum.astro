---
import Paper from '../layouts/Paper.astro';
---

<Paper title="Impressum">
  <section class="legal">
    <h1>Impressum</h1>
    <p class="todo">
      Replace with your legal notice (Angaben gemäß § 5 DDG): full name, postal address and contact email.
      Use a generator or legal advice; don’t publish without it.
    </p>
  </section>
</Paper>

<style>
  .legal {
    max-width: 720px;
    padding: 32px 0;
  }

  h1 {
    font: 900 44px/1.1 var(--font-head);
    margin: 0 0 16px;
  }
</style>
