---
// GitHub Pages serves one 404 for every address, so it speaks both languages.
import Paper from '../layouts/Paper.astro';
import { url } from '../lib/url';
---

<Paper title="Page not found">
  <section class="missing">
    <span class="label kicker">Correction</span>
    <h1>This page is not on the record</h1>
    <p>We couldn’t find a source for that address. <a href={url('/')}>Return to the front page</a>.</p>
    <p lang="de" class="de">
      <strong>Berichtigung:</strong> Diese Seite ist nicht belegt.
      <a href={url('/de/')}>Zur Titelseite</a>.
    </p>
  </section>
</Paper>

<style>
  .missing {
    max-width: 720px;
    padding: 48px 0;
  }

  h1 {
    font: 900 clamp(36px, 5vw, 56px) / 1.05 var(--font-head);
    margin: 10px 0 16px;
  }

  p {
    font-size: 19px;
  }

  .de {
    color: var(--ink-3);
  }
</style>
