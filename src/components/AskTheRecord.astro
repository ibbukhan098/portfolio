---
// "Readers ask the Record": scripted Q&A where every answer cites a source,
// and anything the record can't support is declined.
import Cite from './Cite.astro';
import { questions } from '../data/ask';
import { site } from '../data/site';
---

<section class="ask" aria-labelledby="ask-heading">
  <div class="head"><h2 id="ask-heading" class="label">Readers ask the Record</h2></div>

  <div class="questions" role="group" aria-label="Questions">
    {questions.map((q, i) => (
      <button type="button" class="q" data-q={q.id} aria-pressed={i === 0 ? 'true' : 'false'}>
        <span class="q-mark">Q.</span>
        <span>{q.question}</span>
      </button>
    ))}
  </div>

  <div class="answers" aria-live="polite">
    <p class="nearest label" hidden>Nearest question on file: <span></span></p>
    {questions.map((q, i) => (
      <div class="answer" data-answer={q.id} hidden={i !== 0}>
        {q.declined ? (
          <span class="label status declined">No comment: not on the record</span>
        ) : (
          <span class="label status verified">
            Verified · {q.answer.filter((p) => p.cite).length} source{q.answer.filter((p) => p.cite).length === 1 ? '' : 's'}
          </span>
        )}
        <p>
          <span class="a-mark">A.</span>
          {q.answer.map((part) => (
            <>{part.text}{part.cite && <Cite id={part.cite} />}</>
          ))}
        </p>
      </div>
    ))}
    <div class="answer" data-answer="none" hidden>
      <span class="label status declined">No comment: not on the record</span>
      <p>
        <span class="a-mark">A.</span>
        The Record has no source that answers that, so it won’t guess. Try one of the questions above,
        or <a href={`mailto:${site.email}`}>write to the editor</a>.
      </p>
    </div>
  </div>

  <form class="letter">
    <label for="ask-input" class="sr-only">Your question</label>
    <input id="ask-input" name="q" type="text" placeholder="Send a letter to the editor…" autocomplete="off" />
    <button type="submit" class="label">Send</button>
  </form>

  <p class="corrections">
    <strong class="label">Corrections</strong> None. Answers come from a fixed set of sourced questions,
    and anything else is declined.
  </p>
</section>

<script>
  import { matchQuestion } from '../data/ask';

  for (const root of document.querySelectorAll<HTMLElement>('.ask')) {
    const buttons = root.querySelectorAll<HTMLButtonElement>('.q');
    const answers = root.querySelectorAll<HTMLElement>('.answer');
    const nearest = root.querySelector<HTMLElement>('.nearest')!;
    const form = root.querySelector<HTMLFormElement>('.letter')!;
    const input = form.querySelector<HTMLInputElement>('input')!;

    const show = (id: string) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.q === id)));
      answers.forEach((a) => (a.hidden = a.dataset.answer !== id));
    };

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        nearest.hidden = true;
        show(b.dataset.q!);
      }),
    );

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const text = input.value.trim();
      if (!text) return;
      const match = matchQuestion(text);
      if (match) {
        nearest.querySelector('span')!.textContent = match.question;
        nearest.hidden = false;
        show(match.id);
      } else {
        nearest.hidden = true;
        show('none');
      }
    });
  }
</script>

<style>
  .ask {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .head {
    padding: 8px 0;
    border-top: 4px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .head h2 {
    margin: 0;
  }

  .questions {
    display: flex;
    flex-direction: column;
  }

  .q {
    display: flex;
    gap: 8px;
    width: 100%;
    min-height: 44px;
    padding: 8px 0;
    border: 0;
    border-bottom: 1px solid var(--rule);
    background: none;
    color: var(--ink);
    font: 600 16px/1.35 var(--font-body);
    text-align: left;
    cursor: pointer;
  }

  .q:hover,
  .q[aria-pressed='true'] {
    color: var(--accent);
  }

  .q-mark,
  .a-mark {
    font: 800 12px/1.7 var(--font-label);
  }

  .a-mark {
    font-size: 13px;
    margin-right: 4px;
  }

  .answers {
    padding-top: 6px;
  }

  .answer {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .answer[hidden],
  .nearest[hidden] {
    display: none;
  }

  .answer p {
    margin: 0;
    font-size: 18px;
    line-height: 1.5;
  }

  .status.verified {
    color: var(--verified);
  }

  .status.declined {
    color: var(--accent);
  }

  .nearest {
    margin: 0 0 8px;
    color: var(--ink-3);
    letter-spacing: 0.06em;
  }

  .nearest span {
    color: var(--ink);
  }

  .letter {
    display: flex;
    border: 1px solid var(--ink);
    margin-top: 6px;
  }

  .letter input {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 44px;
    padding: 0 12px;
    border: 0;
    font: italic 400 16px var(--font-body);
    color: var(--ink);
    background: var(--paper);
  }

  .letter button {
    min-height: 44px;
    padding: 0 16px;
    border: 0;
    background: var(--ink);
    color: var(--paper);
    cursor: pointer;
  }

  .letter button:hover {
    background: var(--accent);
  }

  .corrections {
    margin: 0;
    padding: 10px 0;
    border-top: 1px solid var(--rule);
    font-style: italic;
    font-size: 14px;
    line-height: 1.45;
    color: var(--ink-3);
  }

  .corrections strong {
    font-style: normal;
    margin-right: 4px;
    color: var(--ink);
  }
</style>
