---
import { site } from '../data/site';
import { url } from '../lib/url';
---

<footer class="label">
  <span>© {new Date().getFullYear()} {site.paper}. No cookies, no tracking.</span>
  <span class="links">
    {site.links.github && <a href={site.links.github}>GitHub</a>}
    <a href={site.links.linkedin}>LinkedIn</a>
    <a href={url('/sources')}>Sources</a>
    <a href={url('/impressum')}>Impressum</a>
    <a href={url('/datenschutz')}>Datenschutz</a>
  </span>
</footer>

<style>
  footer {
    margin-top: 32px;
    padding-top: 10px;
    border-top: 1px solid var(--ink);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 18px;
  }

  .links a {
    padding: 8px 0;
  }
</style>
