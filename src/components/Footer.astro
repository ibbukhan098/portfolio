---
import { site } from '../data/site';
import { url } from '../lib/url';
import { getLang, localize, t, ui } from '../i18n';

const lang = getLang(Astro.url.pathname);
const link = (path: string) => url(localize(path, lang));
---

<footer class="label">
  <span>© {new Date().getFullYear()} {site.paper}. {t(ui.footerNote, lang)}</span>
  <span class="links">
    <a href={site.links.github}>GitHub</a>
    <a href={site.links.linkedin}>LinkedIn</a>
    <a href={link('/sources')}>{lang === 'de' ? 'Quellen' : 'Sources'}</a>
    <a href={link('/impressum')}>{lang === 'de' ? 'Impressum' : 'Legal notice'}</a>
    <a href={link('/datenschutz')}>{lang === 'de' ? 'Datenschutz' : 'Privacy'}</a>
  </span>
</footer>

<style>
  footer {
    margin-top: 32px;
    padding-top: 10px;
    border-top: 1px solid var(--ink);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 18px;
  }

  .links a {
    padding: 8px 0;
  }
</style>
