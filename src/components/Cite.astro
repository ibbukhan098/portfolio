---
// A footnote marker. Hover or focus shows the source; click jumps to it on /sources.
import { getSource } from '../data/sources';
import { url } from '../lib/url';

interface Props {
  id: string;
}

const source = getSource(Astro.props.id);
const tipId = `tip-${source.id}-${crypto.randomUUID().slice(0, 8)}`;
---

<span class="cite-wrap"><a
    class="cite"
    href={url(`/sources#${source.id}`)}
    aria-describedby={tipId}
    aria-label={`Source ${source.n}`}>{source.n}</a><span class="tip" role="tooltip" id={tipId}>
    <span class="tip-meta">{source.publisher} · {source.date}</span>
    <span class="tip-title">{source.title}</span>
    <span class="tip-excerpt">{source.excerpt}</span>
  </span></span>

<style>
  .cite-wrap {
    position: relative;
  }

  .cite {
    font: 700 0.62em/1 var(--font-label);
    color: var(--accent);
    vertical-align: super;
    text-decoration: none;
    margin-left: 1px;
    padding: 0 2px;
  }

  .cite:hover {
    text-decoration: underline;
  }

  .tip {
    position: absolute;
    z-index: 10;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    width: min(300px, 80vw);
    display: none;
    flex-direction: column;
    gap: 4px;
    padding: 12px 14px;
    background: var(--paper);
    border: 1px solid var(--ink);
    box-shadow: 4px 4px 0 var(--ink);
    text-align: left;
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.4;
    color: var(--ink);
    hyphens: none;
  }

  .cite-wrap:hover .tip,
  .cite:focus-visible + .tip {
    display: flex;
  }

  .tip-meta {
    font: 800 10px/1.3 var(--font-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .tip-title {
    font-weight: 600;
  }

  .tip-excerpt {
    color: var(--ink-2);
  }
</style>
