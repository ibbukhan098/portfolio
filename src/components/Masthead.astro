---
import { site } from '../data/site';
import { edition } from '../lib/edition';
import { url, samePage } from '../lib/url';
import { getLang, localize, counterpart, t, ui, nav } from '../i18n';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const path = Astro.url.pathname;
const lang = getLang(path);
const { volume, number, dateline } = edition(lang);

const editions = [
  { lang: 'en', label: 'English' },
  { lang: 'de', label: 'Deutsch' },
] as const;
---

<header class:list={['masthead', { compact }]}>
  <div class="topbar">
    <nav class="lang label" aria-label={t(ui.languageLabel, lang)}>
      {editions.map((e, i) => (
        <>
          {i > 0 && <span aria-hidden="true">|</span>}
          <a
            href={url(counterpart(path, e.lang))}
            hreflang={e.lang}
            lang={e.lang}
            aria-current={e.lang === lang ? 'true' : undefined}
          >
            {e.label}
          </a>
        </>
      ))}
    </nav>
  </div>

  {!compact && (
    <div class="dateline label">
      <span>{t(ui.volume, lang)} {volume} · {t(ui.number, lang)} {number}</span>
      <span>{site.location}, {dateline}</span>
      <span>{t(ui.price, lang)}</span>
    </div>
  )}

  <div class="title">
    <a href={url(localize('/', lang))} class="name" aria-label={`${site.paper}, ${t(ui.frontPageLabel, lang)}`}>{site.paper}</a>
    {!compact && <p class="motto">“{t(ui.paperTagline, lang)}”</p>}
  </div>

  <nav aria-label="Sections" class="sections">
    {nav.map((item) => {
      const href = url(localize(item.href, lang));
      return (
        <a class="label" href={href} aria-current={samePage(href, path) ? 'page' : undefined}>
          {t(item.label, lang)}
        </a>
      );
    })}
  </nav>
</header>

<style>
  .topbar {
    display: flex;
    justify-content: flex-end;
  }

  .lang {
    display: flex;
    align-items: center;
    gap: 8px;
    letter-spacing: 0.08em;
  }

  .lang a {
    padding: 10px 2px;
    text-decoration: none;
    color: var(--ink-3);
  }

  .lang a[aria-current='true'] {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .lang a:hover {
    color: var(--accent);
  }

  .dateline {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 20px;
    padding: 8px 0;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    letter-spacing: 0.08em;
    font-weight: 700;
  }

  .title {
    text-align: center;
    padding: 18px 0 10px;
    border-bottom: 4px double var(--ink);
  }

  .compact .title {
    border-top: 1px solid var(--ink);
  }

  .name {
    display: inline-block;
    font: 400 clamp(44px, 9vw, 104px) / 1 var(--font-mast);
    text-decoration: none;
  }

  .motto {
    margin: 8px 0 0;
    font-style: italic;
    font-size: 17px;
  }

  .sections {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 28px;
    padding: 4px 0;
    border-bottom: 1px solid var(--ink);
  }

  .sections a {
    padding: 12px 0;
    text-decoration: none;
  }

  .sections a[aria-current='page'] {
    color: var(--accent);
  }

  .compact .title {
    padding: 10px 0 6px;
  }

  .compact .name {
    font-size: clamp(34px, 5vw, 52px);
  }
</style>
