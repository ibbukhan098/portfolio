---
import { site, nav } from '../data/site';
import { edition } from '../lib/edition';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const { volume, number, dateline } = edition();
const path = Astro.url.pathname;
---

<header class:list={['masthead', { compact }]}>
  {!compact && (
    <div class="dateline label">
      <span>Vol. {volume} · No. {number}</span>
      <span>{site.location}, {dateline}</span>
      <span>Price: one interview</span>
    </div>
  )}

  <div class="title">
    <a href="/" class="name" aria-label={`${site.paper}, front page`}>{site.paper}</a>
    {!compact && <p class="motto">“{site.motto}”</p>}
  </div>

  <nav aria-label="Sections">
    {nav.map((item) => (
      <a
        class="label"
        href={item.href}
        aria-current={item.href === path ? 'page' : undefined}
      >
        {item.label}
      </a>
    ))}
  </nav>
</header>

<style>
  .dateline {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 20px;
    padding: 8px 0;
    border-bottom: 1px solid var(--ink);
    letter-spacing: 0.08em;
    font-weight: 700;
  }

  .title {
    text-align: center;
    padding: 18px 0 10px;
    border-bottom: 4px double var(--ink);
  }

  .name {
    display: inline-block;
    font: 400 clamp(44px, 9vw, 104px) / 1 var(--font-mast);
    text-decoration: none;
  }

  .motto {
    margin: 8px 0 0;
    font-style: italic;
    font-size: 17px;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 28px;
    padding: 4px 0;
    border-bottom: 1px solid var(--ink);
  }

  nav a {
    padding: 12px 0;
    text-decoration: none;
  }

  nav a[aria-current='page'] {
    color: var(--accent);
  }

  .compact .title {
    padding: 10px 0 6px;
  }

  .compact .name {
    font-size: clamp(34px, 5vw, 52px);
  }
</style>
